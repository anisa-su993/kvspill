// SPDX-License-Identifier: GPL-2.0-only
//
// Per-segment map/unmap on kernels without dma_map_phys() (< v6.18).
// Covers the direct-path segments from blk-mq-dma on v6.17 and the
// single-segment dma_map_bvec() fast path on every kernel.
// Keyed on the page / DMA address so nested calls do not collide.
// Keys are segment-size buckets in KiB (upper bound).

kfunc:dma_map_page_attrs
/str(args.dev->driver->name) == "nvme"/
{
	@ts_seg[args.page] = (int64)nsecs;
}

kretfunc:dma_map_page_attrs
/@ts_seg[args.page]/
{
	$d = ((int64)nsecs - @ts_seg[args.page]);
	$kb = args.size / 1024;
	$b = $kb <= 4 ? 4 : ($kb <= 64 ? 64 : ($kb <= 128 ? 128 :
	     ($kb <= 512 ? 512 : ($kb <= 1024 ? 1024 :
	     ($kb <= 2048 ? 2048 : 8192)))));
	@seg_map_ns[$b] = hist($d);
	@seg_map_avg_ns[$b] = avg($d);
	@seg_map_count[$b] = count();
	delete(@ts_seg, args.page);
}

kfunc:dma_unmap_page_attrs
/str(args.dev->driver->name) == "nvme"/
{
	@ts_useg[args.addr] = (int64)nsecs;
}

kretfunc:dma_unmap_page_attrs
/@ts_useg[args.addr]/
{
	$d = ((int64)nsecs - @ts_useg[args.addr]);
	$kb = args.size / 1024;
	$b = $kb <= 4 ? 4 : ($kb <= 64 ? 64 : ($kb <= 128 ? 128 :
	     ($kb <= 512 ? 512 : ($kb <= 1024 ? 1024 :
	     ($kb <= 2048 ? 2048 : 8192)))));
	@seg_unmap_ns[$b] = hist($d);
	@seg_unmap_avg_ns[$b] = avg($d);
	@seg_unmap_count[$b] = count();
	delete(@ts_useg, args.addr);
}

END
{
	clear(@ts_seg);
	clear(@ts_useg);
}
