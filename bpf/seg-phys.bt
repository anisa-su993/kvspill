// SPDX-License-Identifier: GPL-2.0-only
//
// Per-segment map/unmap on kernels with dma_map_phys() (>= v6.18).
// dma_map_page_attrs() is a wrapper around dma_map_phys() there, so this
// one probe pair sees both the direct-path segments from blk-mq-dma and
// the single-segment dma_map_bvec() fast path without double counting.
// Keyed on the physical / DMA address so nested calls do not collide.
// Keys are segment-size buckets in KiB (upper bound).

kfunc:dma_map_phys
/str(args.dev->driver->name) == "nvme"/
{
	@ts_seg[args.phys] = (int64)nsecs;
}

kretfunc:dma_map_phys
/@ts_seg[args.phys]/
{
	$d = ((int64)nsecs - @ts_seg[args.phys]);
	$kb = args.size / 1024;
	$b = $kb <= 4 ? 4 : ($kb <= 64 ? 64 : ($kb <= 128 ? 128 :
	     ($kb <= 512 ? 512 : ($kb <= 1024 ? 1024 :
	     ($kb <= 2048 ? 2048 : 8192)))));
	@seg_map_ns[$b] = hist($d);
	@seg_map_avg_ns[$b] = avg($d);
	@seg_map_count[$b] = count();
	delete(@ts_seg, args.phys);
}

kfunc:dma_unmap_phys
/str(args.dev->driver->name) == "nvme"/
{
	@ts_useg[args.addr] = (int64)nsecs;
}

kretfunc:dma_unmap_phys
/@ts_useg[args.addr]/
{
	$d = ((int64)nsecs - @ts_useg[args.addr]);
	$kb = args.size / 1024;
	$b = $kb <= 4 ? 4 : ($kb <= 64 ? 64 : ($kb <= 128 ? 128 :
	     ($kb <= 512 ? 512 : ($kb <= 1024 ? 1024 :
	     ($kb <= 2048 ? 2048 : 8192)))));
	@seg_unmap_ns[$b] = hist($d);
	@seg_unmap_avg_ns[$b] = avg($d);
	@seg_unmap_count[$b] = count();
	delete(@ts_useg, args.addr);
}

END
{
	clear(@ts_seg);
	clear(@ts_useg);
}
