// SPDX-License-Identifier: GPL-2.0-only
//
// Driver-level per-request cost: nvme_map_data() and nvme_unmap_data()
// wrap everything nvme-pci does to make a request DMA-ready (DMA API calls
// plus PRP/SGL list construction and pool allocation). Same symbols on both
// the scatterlist and the two-step kernels, so this is the like-for-like
// total; the API-level maps say where inside it the time went.
//
// Both are static and may be inlined; kvspill-dmacost only appends this
// fragment when they are present in kallsyms. The request argument is
// named "req" in both eras, so keying on args.req works on either.

kfunc:nvme_map_data
{
	@ts_nmap[args.req] = (int64)nsecs;
}

kretfunc:nvme_map_data
/@ts_nmap[args.req]/
{
	@nvme_map_ns = hist(((int64)nsecs - @ts_nmap[args.req]));
	@nvme_map_avg_ns = avg(((int64)nsecs - @ts_nmap[args.req]));
	delete(@ts_nmap, args.req);
}

kfunc:nvme_unmap_data
{
	@ts_nunmap[args.req] = (int64)nsecs;
}

kretfunc:nvme_unmap_data
/@ts_nunmap[args.req]/
{
	@nvme_unmap_ns = hist(((int64)nsecs - @ts_nunmap[args.req]));
	@nvme_unmap_avg_ns = avg(((int64)nsecs - @ts_nunmap[args.req]));
	delete(@ts_nunmap, args.req);
}

END
{
	clear(@ts_nmap);
	clear(@ts_nunmap);
}
